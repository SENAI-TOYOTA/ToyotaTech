    {
        "id": "54dceb1527bf7435",
        "type": "function",
        "z": "57096583d9456372",
        "name": "function 1",
        "func": "let p = msg.payload;\nif (typeof p === \"string\") { p = JSON.parse(p); }\n\nmsg.measurement = \"linha\";\n\n// 1. Identifica se o dado veio no formato do Influx (com fields/tags) ou direto do Python (cru)\nlet fields = p.fields || p;\nlet tags = p.tags || {};\n\n// 2. Garante o mapeamento das TAGS para o InfluxDB\nmsg.tags = {\n    chassi: String(tags.chassi || fields.chassi || fields.chassi_nome || \"Toyota-\" + Math.floor(Math.random() * 1000)),\n    etapa:  String(tags.etapa  || fields.etapa  || fields.etapa_nome  || \"Fase-\" + (fields.posicao_linha || 1)),\n    status: String(tags.status || fields.status || fields.status_nome || (fields.posicao_linha === 5 ? \"Finalizado\" : \"Iniciado\"))\n};\n\n// 3. Garante o mapeamento dos FIELDS (Campos de texto limpos para o seu novo Grafana)\nmsg.payload = {\n    valor:         Number(fields.valor ?? 1),\n    tempo_etapa:   Number(fields.tempo_etapa ?? 0),\n    posicao_linha: Number(fields.posicao_linha ?? 0),\n    falha:         Number(fields.falha ?? 0),\n    retrabalho:    Number(fields.retrabalho ?? 0),\n    tempo_total:   Number(fields.tempo_total ?? 0),\n    \n    // As strings que o seu novo Grafana vai ler direto, sem precisar de if/else!\n    chassi_nome:   String(msg.tags.chassi),\n    etapa_nome:    String(fields.etapa_nome  || (fields.posicao_linha === 1 ? \"Produção iniciada\" : fields.posicao_linha === 2 ? \"Montagem finalizada\" : fields.posicao_linha === 3 ? \"Teste de qualidade\" : fields.posicao_linha === 4 ? \"Transporte\" : fields.posicao_linha === 5 ? \"Pronto para retirada\" : \"Em andamento\")),\n    status_nome:   String(msg.tags.status)\n};\n\n// 4. Ajusta o timestamp se existir\nif (p.time || p.timestamp) {\n    msg.timestamp = new Date(p.time || p.timestamp).getTime();\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
